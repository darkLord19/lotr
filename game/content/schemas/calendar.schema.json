{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shire Reckoning calendar table",
  "type": "object",
  "required": ["comment", "epoch_ta_year", "sr_year_offset", "shire_index_shift", "year_rollover_index", "days_in_year", "leap_day_name", "periods"],
  "additionalProperties": false,
  "properties": {
    "comment": {"type": "string", "minLength": 20},
    "epoch_ta_year": {"type": "integer"},
    "sr_year_offset": {"type": "integer"},
    "shire_index_shift": {"type": "integer"},
    "year_rollover_index": {"type": "integer"},
    "days_in_year": {"const": 365},
    "leap_day_name": {"type": "string"},
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "first_index", "length", "intercalary"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "first_index": {"type": "integer", "minimum": 0},
          "length": {"type": "integer", "minimum": 1},
          "intercalary": {"type": "boolean"}
        }
      }
    },
    "verify": {"type": "boolean"}
  }
}
