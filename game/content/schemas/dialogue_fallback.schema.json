{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dialogue fallback lines for one NPC (used offline or when the LLM fails)",
  "$defs": {
    "line": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "from": {"$ref": "_defs.json#/$defs/date"},
            "until": {"$ref": "_defs.json#/$defs/date"},
            "requires_flag": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}}
  },
  "type": "object",
  "required": ["npc", "greetings", "farewells", "smalltalk", "rumour_lines"],
  "additionalProperties": false,
  "properties": {
    "npc": {"$ref": "_defs.json#/$defs/id"},
    "greetings": {"$ref": "#/$defs/lines"},
    "farewells": {"$ref": "#/$defs/lines"},
    "smalltalk": {"$ref": "#/$defs/lines"},
    "rumour_lines": {
      "type": "object",
      "propertyNames": {"$ref": "_defs.json#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/lines"}
    }
  }
}
