{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rumours file (array)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "text", "origin_poi", "start", "strength", "max_hops", "hours_per_hop"],
    "additionalProperties": false,
    "properties": {
      "id": {"$ref": "_defs.json#/$defs/id"},
      "text": {"type": "string", "minLength": 1},
      "origin_poi": {"$ref": "_defs.json#/$defs/id"},
      "start": {"$ref": "_defs.json#/$defs/date"},
      "strength": {"type": "integer", "minimum": 1},
      "max_hops": {"type": "integer", "minimum": 0},
      "hours_per_hop": {"type": "number", "exclusiveMinimum": 0},
      "verify": {"type": "boolean"}
    }
  }
}
