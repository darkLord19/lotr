{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World placements (generated by tools/terrain/place_world.py)",
  "type": "object",
  "required": ["version", "region", "cell_m", "models", "foliage", "objects", "barriers", "pois", "forage", "interactables"],
  "properties": {
    "version": {"const": 1},
    "region": {"type": "string"},
    "cell_m": {"type": "number", "exclusiveMinimum": 0},
    "models": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "lods", "collide"]}},
    "foliage": {"type": "array", "items": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}},
    "objects": {"type": "array", "items": {"type": "object", "required": ["id", "model", "kind", "pos", "yaw", "scale"]}},
    "forage": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "item", "pos", "yield"], "properties": {"zone": {"type": "string"}}}
    },
    "interactables": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "kind", "label", "pos"], "properties": {"kind": {"enum": ["door", "well", "bed", "food"]}}}
    }
  }
}
